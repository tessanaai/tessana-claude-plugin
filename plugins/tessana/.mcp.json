{
  "mcpServers": {
    "tessana": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/server/index.mjs"],
      "env": {
        "TESSANA_API_KEY": "${user_config.api_key}",
        "TESSANA_BASE_URL": "${TESSANA_BASE_URL:-https://app.tessanaai.com}",
        "NODE_USE_ENV_PROXY": "1"
      }
    }
  }
}
